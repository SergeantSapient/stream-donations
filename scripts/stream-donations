#!/bin/sh
# Launch the Electron shell. The shell starts the Python collector.
# This does not install packages and does not ask for root. The ledger and
# API secrets stay in the home directory, not next to this file.
set -eu
if [ "$(id -u)" -eq 0 ]; then
  echo "Run Stream Donations as your user, not as root." >&2
  exit 1
fi
ROOT=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
if [ -x "$ROOT/electron/electron" ]; then
  ELECTRON="$ROOT/electron/electron"
elif [ -x "$ROOT/app/node_modules/electron/dist/electron" ]; then
  ELECTRON="$ROOT/app/node_modules/electron/dist/electron"
else
  echo "Electron is not next to this launcher. From a checkout, run scripts/build.sh." >&2
  exit 1
fi
if [ -z "${STREAM_DONATIONS_PYTHON:-}" ]; then
  if [ -x "$ROOT/python/bin/python3" ]; then
    STREAM_DONATIONS_PYTHON="$ROOT/python/bin/python3"
  elif command -v python3 >/dev/null 2>&1; then
    STREAM_DONATIONS_PYTHON=python3
  else
    echo "python3 was not found. The portable Linux package carries one in python/bin." >&2
    exit 1
  fi
  export STREAM_DONATIONS_PYTHON
fi
# A path inside this folder, or the old checkout data/ directory, must not
# win. The collector then uses the home directory.
LEGACY=""
if [ -d "$ROOT/../source/collector/streamdonations" ]; then
  LEGACY=$(CDPATH= cd -- "$ROOT/.." && pwd)/data
fi
case "${STREAM_DONATIONS_DATA:-}" in
  "" ) ;;
  "$ROOT"|"$ROOT"/*|"$LEGACY"|"$LEGACY"/*)
    unset STREAM_DONATIONS_DATA
    ;;
esac
# File dialogs can go through the session portal when the desktop offers one.
if [ -z "${GTK_USE_PORTAL+x}" ]; then
  export GTK_USE_PORTAL=1
fi
# A per-user desktop entry lets the session match this window to an icon.
# An AppImage already carries its own entry, and its mount path changes.
if [ -z "${APPIMAGE:-}" ]; then
  data="${XDG_DATA_HOME:-$HOME/.local/share}"
  case "$data" in
    "$HOME"|"$HOME"/*)
      icon_dir="$data/icons/hicolor/256x256/apps"
      if [ -f "$ROOT/app/icon.png" ] && mkdir -p "$icon_dir" "$data/applications"; then
        cp "$ROOT/app/icon.png" "$icon_dir/stream-donations.png"
        cat > "$data/applications/stream-donations.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Stream Donations
Comment=Local ledger of Super Chats, Super Stickers, and memberships
Exec=$ROOT/$(basename "$0")
Icon=stream-donations
StartupWMClass=stream-donations
Terminal=false
Categories=Utility;
EOF
      fi
      ;;
  esac
fi
# The AppImage mount cannot use Electron's sandbox helper. A normal directory
# launch keeps the sandbox.
if [ -n "${APPIMAGE:-}" ]; then
  exec "$ELECTRON" --no-sandbox --class=stream-donations "$ROOT/app" "$@"
fi
exec "$ELECTRON" --class=stream-donations "$ROOT/app" "$@"
